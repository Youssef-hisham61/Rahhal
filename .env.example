# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rahhal_db
DB_USER=rahhal_user
DB_PASSWORD=change_this_password

# JWT
JWT_SECRET=change_this_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
NODE_ENV=development
FRONTEND_URL=http://localhost
PORT=5000

# Owner seed (used once at first boot)
OWNER_EMAIL=owner@rahhal.com
OWNER_PASSWORD=change_this_owner_password
OWNER_NAME=صاحب النظام
